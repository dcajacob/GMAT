% Function that calculated the separation
% between two spacecraft
function [delta] = SatSep(Sat1, Sat2);

Create Variable delta;
Create Array dr[3,1];

BeginMissionSequence;
Global dz dy dx;

dx = Sat2.X - Sat1.X;
dy = Sat2.Y - Sat1.Y;
dz = Sat2.Z - Sat1.Z;

dr(1,1) = dx;
dr(2,1) = dy;
dr(3,1) = dz;

delta = sqrt(dot(dr, dr));

