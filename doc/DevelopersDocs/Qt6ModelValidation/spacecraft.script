Create Spacecraft QtSat;
QtSat.ModelFile = 'aura.3ds';
QtSat.ModelScale = 1;
Create ForceModel QtForces;
QtForces.CentralBody = Earth;
QtForces.PrimaryBodies = {Earth};
Create Propagator QtProp;
QtProp.FM = QtForces;
QtProp.MaxStep = 30;
Create CoordinateSystem QtSatFrame;
QtSatFrame.Origin = QtSat;
QtSatFrame.Axes = MJ2000Eq;
Create OrbitView QtOrbit;
QtOrbit.Add = {QtSat};
QtOrbit.CoordinateSystem = QtSatFrame;
QtOrbit.EnableStars = Off;
QtOrbit.EnableConstellations = Off;
QtOrbit.XYPlane = Off;
QtOrbit.Axes = Off;
QtOrbit.UpperLeft = [0 0];
QtOrbit.Size = [1 1];
QtOrbit.ViewPointVector = [2000 -5000 3000];
BeginMissionSequence;
Propagate QtProp(QtSat) {QtSat.ElapsedSecs = 12000};
