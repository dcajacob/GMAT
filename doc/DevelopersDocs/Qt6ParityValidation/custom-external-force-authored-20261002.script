% Owned constant ExternalForce fixture; no bundled mission seed.
Create Spacecraft Probe;
Probe.DateFormat = UTCGregorian;
Probe.Epoch = '01 Jan 2015 12:00:00.000';
Probe.CoordinateSystem = EarthMJ2000Eq;
Probe.DisplayStateType = Cartesian;
Probe.X = 7000;
Probe.Y = 0;
Probe.Z = 0;
Probe.VX = 0;
Probe.VY = 7.5;
Probe.VZ = 0;
Create ForceModel ConstEnv;
ConstEnv.CentralBody = Earth;
ConstEnv.PrimaryBodies = {};
ConstEnv.PointMasses = {Earth};
ConstEnv.Drag = None;
ConstEnv.SRP = Off;
Create PropSetup Stepper;
Stepper.FM = ConstEnv;
Stepper.Type = RungeKutta89;
Stepper.InitialStepSize = 10;
Stepper.MaxStep = 10;
Create ReportFile Result;
Result.Filename = 'constant-state.txt';
Result.Precision = 16;
Result.WriteHeaders = false;
Result.WriteReport = false;
GMAT ConstEnv.External = 'QtOwnedConstantForce';
GMAT ConstEnv.External.DerivativesFunction = 'GetConstantAcceleration';
GMAT ConstEnv.External.ExcludeOtherForces = true;
BeginMissionSequence;
Report Result Probe.ElapsedSecs Probe.EarthMJ2000Eq.X Probe.EarthMJ2000Eq.Y Probe.EarthMJ2000Eq.Z Probe.EarthMJ2000Eq.VX Probe.EarthMJ2000Eq.VY Probe.EarthMJ2000Eq.VZ;
Propagate Stepper(Probe) {Probe.ElapsedSecs = 60};
Report Result Probe.ElapsedSecs Probe.EarthMJ2000Eq.X Probe.EarthMJ2000Eq.Y Probe.EarthMJ2000Eq.Z Probe.EarthMJ2000Eq.VX Probe.EarthMJ2000Eq.VY Probe.EarthMJ2000Eq.VZ;
