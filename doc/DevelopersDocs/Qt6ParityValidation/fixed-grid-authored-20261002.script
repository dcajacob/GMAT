% Owned positive FixedGrid fixture; no mission sample used.
Create Spacecraft GridSat;
GridSat.DateFormat = UTCGregorian;
GridSat.Epoch = '01 Jan 2015 12:00:00.000';
GridSat.CoordinateSystem = EarthFixed;
GridSat.DisplayStateType = Cartesian;
GridSat.X = 42164;
GridSat.Y = 0;
GridSat.Z = 0;
GridSat.VX = 0;
GridSat.VY = 0;
GridSat.VZ = 0;
GridSat.NAIFId = -15001;
GridSat.NAIFIdReferenceFrame = -15001000;
Create ConicalFOV GridCone;
GridCone.FieldOfViewAngle = 60;
Create Imager GridCamera;
GridCamera.FieldOfView = GridCone;
GridCamera.DirectionX = 1;
GridCamera.DirectionY = 0;
GridCamera.DirectionZ = 0;
GridSat.AddHardware = {GridCamera};
Create ForceModel Gravity;
Gravity.PrimaryBodies = {};
Gravity.PointMasses = {Earth};
Create Propagator Prop;
Prop.FM = Gravity;
Prop.Type = RungeKutta89;
Prop.InitialStepSize = 10;
Create IntrusionLocator GridEvents;
GridEvents.Spacecraft = GridSat;
GridEvents.Sensors = {GridCamera};
GridEvents.IntrudingBodies = {Sun};
GridEvents.CentralBody = Earth;
GridEvents.MinimumPhase = 0;
GridEvents.StepSize = 10;
GridEvents.UseLightTimeDelay = false;
GridEvents.UseStellarAberration = false;
GridEvents.WriteReport = true;
GridEvents.UseEntireInterval = true;
GridEvents.RunMode = Automatic;
GridEvents.Filename = 'fixed-grid-events.txt';
GridEvents.ReportCoordinates = 'FixedGrid';
GridEvents.SpiceGridFrameFile = '/home/dan/GIT/GMAT-Qt/build/example-qualification/20261002/fixed-grid-input/qt-fixed-grid.tf';
Prop.MaxStep = 10;
BeginMissionSequence;
Propagate Prop(GridSat) {GridSat.ElapsedSecs = 300};
