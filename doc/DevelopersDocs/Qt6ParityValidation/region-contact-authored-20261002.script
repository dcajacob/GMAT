Create ContactLocator GateEvents;
Create PlanetographicRegion Gate;
% Owned Region overflight fixture; independent declared input.
Create Spacecraft Scout;
Scout.DateFormat = UTCGregorian;
Scout.Epoch = '01 Jan 2015 12:00:00.000';
Scout.CoordinateSystem = EarthFixed;
Scout.DisplayStateType = Cartesian;
Scout.X = 7000;
Scout.Y = 0;
Scout.Z = 0;
Scout.VX = 0;
Scout.VY = 7.5;
Scout.VZ = 0;
Create ForceModel Env;
Env.CentralBody = Earth;
Env.PrimaryBodies = {};
Env.PointMasses = {Earth};
Env.Drag = None;
Env.SRP = Off;
Create PropSetup Stepper;
Stepper.FM = Env;
Stepper.Type = RungeKutta89;
Stepper.InitialStepSize = 10;
Stepper.MaxStep = 10;
Create ReportFile States;
States.Filename = 'region-states.txt';
States.Precision = 16;
States.Add = {Scout.ElapsedSecs, Scout.EarthFixed.X, Scout.EarthFixed.Y, Scout.EarthFixed.Z};
Gate.Latitude = [10 10 -10 -10];
Gate.Longitude = [5 -5 -5 5];
GateEvents.Target = Gate;
GateEvents.Filename = 'region-events.txt';
GateEvents.UseLightTimeDelay = false;
GateEvents.UseStellarAberration = false;
GateEvents.Observers = {Scout};
GateEvents.LightTimeDirection = Receive;
BeginMissionSequence;
Propagate Stepper(Scout) {Scout.ElapsedSecs = 300};
