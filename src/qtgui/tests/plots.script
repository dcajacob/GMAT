% Exercise native GMAT subscribers together in the Qt workspace.
Create Spacecraft QtSat;
Create ForceModel QtForces;
QtForces.CentralBody = Earth;
QtForces.PrimaryBodies = {Earth};
Create Propagator QtProp;
QtProp.FM = QtForces;
QtProp.MaxStep = 5;
Create OrbitView QtOrbit;
QtOrbit.Add = {QtSat, Earth};
QtOrbit.CoordinateSystem = EarthMJ2000Eq;
QtOrbit.EnableStars = Off;
QtOrbit.EnableConstellations = Off;
QtOrbit.XYPlane = Off;
QtOrbit.UpperLeft = [0 0];
QtOrbit.Size = [0.5 0.5];
Create GroundTrack QtGround;
QtGround.Add = {QtSat};
QtGround.UpperLeft = [0.5 0];
QtGround.Size = [0.5 0.5];
Create GroundTrack QtSampledGround;
QtSampledGround.Add = {QtSat};
QtSampledGround.DataCollectFrequency = 7;
QtSampledGround.UpdatePlotFrequency = 13;
QtSampledGround.MaxPlotPoints = 50;
QtSampledGround.LineWidth = 3;
Create XYPlot QtXY;
QtXY.XVariable = QtSat.ElapsedSecs;
QtXY.YVariables = {QtSat.EarthMJ2000Eq.X, QtSat.EarthMJ2000Eq.Y};
QtXY.ShowGrid = true;
QtXY.UpperLeft = [0 0.5];
QtXY.Size = [0.5 0.5];
Create ReportFile QtReport;
QtReport.Filename = 'QtPlotReference.txt';
QtReport.WriteHeaders = false;
QtReport.Precision = 16;
Create DynamicDataDisplay QtData;
QtData.AddParameters = {1, QtSat.ElapsedSecs, QtSat.EarthMJ2000Eq.X};
QtData.RowTextColors = {1, [20 80 150], [20 80 150]};
BeginMissionSequence;
Propagate QtProp(QtSat) {QtSat.ElapsedSecs = 12000};
Report QtReport QtSat.ElapsedSecs QtSat.EarthMJ2000Eq.X QtSat.EarthMJ2000Eq.Y QtSat.EarthMJ2000Eq.Z QtSat.Earth.Longitude QtSat.Earth.Latitude;
UpdateDynamicData QtData;
