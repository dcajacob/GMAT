% Exercise the core dynamics engine and write a checkable state report.
Create Spacecraft BuildTestSat;
Create ForceModel BuildTestForces;
BuildTestForces.CentralBody = Earth;
BuildTestForces.PrimaryBodies = {Earth};
BuildTestForces.GravityField.Earth.Degree = 4;
BuildTestForces.GravityField.Earth.Order = 4;
Create Propagator BuildTestProp;
BuildTestProp.FM = BuildTestForces;
Create OrbitView BuildTestView;
BuildTestView.Add = {BuildTestSat, Earth};
Create ReportFile BuildTestReport;
BuildTestReport.Filename = 'BuildGuiSmokeTest.txt';
BuildTestReport.Precision = 16;
BeginMissionSequence;
Report BuildTestReport BuildTestSat.ElapsedSecs BuildTestSat.X BuildTestSat.Y BuildTestSat.Z;
Propagate BuildTestProp(BuildTestSat) {BuildTestSat.ElapsedSecs = 60};
Report BuildTestReport BuildTestSat.ElapsedSecs BuildTestSat.X BuildTestSat.Y BuildTestSat.Z;
